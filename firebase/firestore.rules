rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Top-level users collection
    match /users {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // User documents and tenant subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Profile subcollection (company info)
      match /profile/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Products subcollection
      match /products/{productId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // Stats subcollection (dashboard counters, yearly metrics)
      match /stats/{statDoc} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Collection Group Queries for Admin analytics
    match /{path=**}/invoices/{invoiceId} {
      allow read: if isAdmin();
    }

    match /{path=**}/products/{productId} {
      allow read: if isAdmin();
    }

    // Platform-wide overview stats
    match /platform_stats/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Admin directory
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.uid == adminId ||
        isAdmin()
      );
    }
  }
}
